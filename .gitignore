# =========================================================
# Wooo Musique — fichiers à ignorer par Git
# =========================================================

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs et caches
*.log
.cache/
.tmp/

# Dépendances Node (si on en ajoute un jour)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables d'environnement (secrets)
.env
.env.local
.env.*.local

# Builds locaux et fichiers de déploiement temporaires
dist/
build/
.vercel/
.netlify/

# Archives temporaires
wooo.zip
*.zip
